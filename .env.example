PORT=

# Get it from telegram BotFather
BOT_TOKEN=

# Git it from telegram devopers website
APP_ID=
API_HASH=

# Get telegram details
STORAGE_GROUP_ID=
ADMIN_ID=
# Telegram supergroups and channels have negative IDs internally. The 3843778132 you had is just the bare numeric part — the full API-compatible ID always has a -100 prefix, making it -1003843778132. Without the prefix, Telethon interprets it as a regular user ID (PeerUser) and fails to resolve it.

# Firebase Firestore
FIREBASE_SECRETS=

# From Terabox website
COOKIES1=
COOKIES2=
COOKIES3=
COOKIES4=
...

THIRD_PARTY_TERABOXDL_URL=
PROXY_URL=

# Diskwala scraper proxy (POST endpoint, api key sent as the x-api-key header)
DISKWALA_PROXY_URL=
DISKWALA_API_KEY=

# Flezen scraper proxy (POST endpoint, api key sent as the x-api-key header)
FLEZEN_PROXY_URL=
FLEZEN_API_KEY=

TELEGRAM_CONCURRENCY_LIMIT=100
# Maximum active requests from one chat. Completed jobs immediately free a slot.
PER_CHAT_CONCURRENCY=10
# Waiting requests only. A chat can have 10 active plus 20 pending requests.
PER_CHAT_PENDING_LIMIT=20
# Waiting requests across every chat. This prevents a bot-wide memory backlog.
GLOBAL_PENDING_LIMIT=500
# Applied to every group; set 0 to disable. Limits one sender's pending jobs.
PER_USER_GROUP_PENDING_LIMIT=5
# Expire jobs that have not started after this duration; set 0 to disable.
TELEGRAM_QUEUE_MAX_WAIT_SECONDS=1800
# Delete each delivered media message after 30 minutes; set 0 to disable.
TELEGRAM_MEDIA_AUTO_DELETE_SECONDS=1800
TELEGRAM_GLOBAL_SEND_RATE=28
TELEGRAM_PRIVATE_CHAT_RATE=1
TELEGRAM_GROUP_CHAT_RATE=0.333
